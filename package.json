{
  "name": "surround-lines",
  "displayName": "surround-lines",
  "description": "Surround the selected lines with a header and footer.",
  "version": "0.0.1",
  "publisher": "Matsuyanagi",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matsuyanagi/surround-lines.git"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.surroundLines",
        "title": "Surround Lines"
      }
    ],
    "configuration": {
      "title": "Surround Lines",
      "properties": {
        "surroundLines.formats": {
          "type": "array",
          "default": [
            {
              "name": "comment",
              "header": "/*",
              "footer": "*/",
              "indent": true
            }
          ],
          "description": "Available header and footer formats.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "header",
              "footer",
              "indent"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "Header text. Supports the date variables documented in the extension README."
              },
              "footer": {
                "type": "string",
                "description": "Footer text. Supports the date variables documented in the extension README."
              },
              "indent": {
                "type": "boolean"
              },
              "languageId": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
